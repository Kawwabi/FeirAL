# Banco de dados (SQLite local - zero config)
DATABASE_URL="file:./dev.db"

# Segredo para assinatura de sessao (JWT). Troque em producao.
AUTH_SECRET="feiral-dev-secret-change-me-in-production-please-0123456789"

# URL publica do site (usada em links de calendario e SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Inteligencia Artificial (opcional) ---
# Modo: auto | local | kobold | openai | none
#   auto   = nuvem se houver AI_API_KEY; caso contrario usa LLM local se AI_BASE_URL for localhost
#   local  = endpoint compativel com OpenAI, SEM exigir chave (KoboldCpp /v1, Ollama, LM Studio)
#   openai = nuvem (exige AI_API_KEY)
#   none   = usa somente o assistente local por regras (funciona offline)
AI_PROVIDER="none"

# Endpoint de IA. Exemplos:
#   Ollama ............. http://localhost:11434/v1
#   LM Studio .......... http://localhost:1234/v1
#   OpenAI (nuvem) ..... https://api.openai.com/v1
AI_BASE_URL="http://localhost:5001/v1"

# Chave de API. Obrigatoria apenas no modo "openai".
# Deixe vazio para LLM local (KoboldCpp/Ollama/LM Studio).
# Se usar KoboldCpp com --password, informe a senha aqui.
AI_API_KEY=""

# Nome do modelo. Para LLM local pode ser qualquer valor.
AI_MODEL=""

# Tempo maximo de espera da resposta (ms). LLM local pode ser lento: 60000 = 60s.
AI_TIMEOUT_MS="60000"